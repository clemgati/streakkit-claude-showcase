{
  "mcpServers": {
    "streakkit": {
      "command": "python3",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/.claude/mcp/streakkit_mcp.py"],
      "env": {
        "STREAKKIT_ROOT": "${CLAUDE_PROJECT_DIR:-.}"
      }
    },

    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },

    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${CLAUDE_PROJECT_DIR:-.}/docs",
        "${CLAUDE_PROJECT_DIR:-.}/shared"
      ]
    },

    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
